# Serves website/dist on Fly. TLS ends at Fly's edge; this listens on plain HTTP inside the VM.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# app.js and app_bg.wasm keep their names across deploys: revalidate them (Caddy sends an
	# ETag), as the pages are. Images and fonts change rarely.
	header /app/* Cache-Control "public, max-age=0, must-revalidate"
	header /img/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
	header /app/*.ttf Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	handle /healthz {
		respond "ok" 200
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
