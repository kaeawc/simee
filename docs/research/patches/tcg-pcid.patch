+void tlb_switch_pcid(CPUState *cpu, uint16_t pcid, bool flush)
+{
+    struct TLBBanks *bs = cpu->tlb_banks;
+    TLBBank *hit = NULL, *b = NULL;
+    uint16_t left = cpu->tlb_pcid;
+
+    assert_cpu_is_self(cpu);
+
+    if (pcid == left) {
+        if (flush) {
+            tlb_flush_live_work(cpu, RUN_ON_CPU_HOST_INT(ALL_MMUIDX_BITS));
+        }
+        return;
+    }
+    if (!bs) {
+        bs = g_new0(struct TLBBanks, 1);
+        qemu_spin_lock(&cpu->neg.tlb.c.lock);
+        qatomic_set(&cpu->tlb_banks, bs);
+        qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    }
+
+    for (int i = 0; i < TLB_NBANKS; i++) {
+        if (bs->bank[i].valid && bs->bank[i].pcid == pcid) {
+            hit = &bs->bank[i];
+            break;
+        }
+    }
+    if (hit) {
+        b = hit;
+    } else {
+        /* Reuse a bank that was dropped, else make one, else the oldest. */
+        for (int i = 0; i < TLB_NBANKS; i++) {
+            TLBBank *c = &bs->bank[i];
+
+            if (!c->valid) {
+                if (!b || b->valid || (!b->init && c->init)) {
+                    b = c;
+                }
+            } else if (!b || (b->valid && c->last_used < b->last_used)) {
+                b = c;
+            }
+        }
+        if (!b->init) {
+            tlb_bank_init(b);
+        }
+    }
+
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    tlb_bank_swap_locked(cpu, b);
+    if (hit && b->pend_hi) {
+        /* the entering PCID's entries missed write protection meanwhile */
+        for (MMUIdxMap w = cpu->neg.tlb.c.dirty; w != 0; w &= w - 1) {
+            int idx = ctz32(w);
+
+            tlb_reset_dirty_one_locked(&cpu->neg.tlb.d[idx], cpu_tlb_fast(cpu, idx),
+                                       b->pend_lo, b->pend_hi - b->pend_lo);
+        }
+    }
+    b->pend_lo = b->pend_hi = 0;
+    b->pcid = left;
+    b->valid = true;
+    b->last_used = ++bs->clock;
+    cpu->tlb_pcid = pcid;
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    qatomic_set(&cpu->neg.tlb.c.pcid_switch_count,
+                cpu->neg.tlb.c.pcid_switch_count + 1);
+    if (hit) {
+        qatomic_set(&cpu->neg.tlb.c.pcid_hit_count,
+                    cpu->neg.tlb.c.pcid_hit_count + 1);
+    }
+    if (!hit || flush) {
+        tlb_flush_live_work(cpu, RUN_ON_CPU_HOST_INT(ALL_MMUIDX_BITS));
+    }
+}
+
+/* tb_flush() reset the code buffer: no jump cache may point into it. */
+void tlb_banks_flush_jmp_caches(CPUState *cpu)
+{
+    struct TLBBanks *bs = qatomic_read(&cpu->tlb_banks);
+
+    if (!bs) {
+        return;
+    }
+    for (int i = 0; i < TLB_NBANKS; i++) {
+        CPUJumpCache *jc = bs->bank[i].jc;
+
+        if (jc) {
+            for (int j = 0; j < TB_JMP_CACHE_SIZE; j++) {
+                qatomic_set(&jc->array[j].tb, NULL);
+            }
+        }
+    }
+}
