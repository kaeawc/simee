+/* One page out of a kept PCID's tables. Called with tlb_c.lock held. */
+static void tlb_bank_flush_page_locked(CPUTLBDesc *d, CPUTLBDescFast *f,
+                                       vaddr page)
+{
+    CPUTLBEntry *e;
+
+    if ((page & d->large_page_mask) == d->large_page_addr) {
+        tlb_mmu_flush_locked(d, f);
+        return;
+    }
+    e = &f->table[(page >> TARGET_PAGE_BITS) & (f->mask >> CPU_TLB_ENTRY_BITS)];
+    if (tlb_flush_entry_locked(e, page)) {
+        d->n_used_entries--;
+    }
+    for (int k = 0; k < CPU_VTLB_SIZE; k++) {
+        if (tlb_flush_entry_locked(&d->vtable[k], page)) {
+            d->n_used_entries--;
+        }
+    }
+}
