+/*
+ * PCID banks.
+ *
+ * A guest that tags its address spaces with PCIDs (x86 CR4.PCIDE) may switch
+ * back to one whose translations are still valid. QEMU's soft TLB and jump
+ * cache hold the translations of one address space, so each change of page
+ * table root used to drop both, and everything the next few hundred guest
+ * instructions touched had to be walked and looked up again.
+ *
+ * Here the translations of the PCID being left are kept in a bank (the dirty
+ * MMU indexes' tables, victim entries and the jump cache, which move by
+ * swapping) and those of the PCID being entered come back if they are in a
+ * bank. Any flush that is not a PCID-aware change of root (tlb_flush*, a CR4
+ * change, a memory map update, ...) drops every bank, and a page flush
+ * (INVLPG, which also drops global entries of every PCID) reaches them all.
+ * A write-protect range (tlb_reset_dirty: code was translated from those
+ * pages) is remembered and applied when the PCID comes back, and a bank that
+ * would have to apply too much is dropped.
+ */
+#define TLB_NBANKS 8
+
+typedef struct TLBBank {
+    bool init;
+    bool valid;
+    uint16_t pcid;
+    uint64_t last_used;
+    MMUIdxMap dirty;
+    /* Host range whose writable entries still have to lose their write permission (tlb_reset_dirty) */
+    uintptr_t pend_lo, pend_hi;
+    CPUTLBDesc d[NB_MMU_MODES];
+    CPUTLBDescFast f[NB_MMU_MODES];
+    CPUJumpCache *jc;
+} TLBBank;
+
+static void tlb_reset_dirty_one_locked(CPUTLBDesc *desc, CPUTLBDescFast *fast,
+                                       uintptr_t start, uintptr_t length);
+
+/* A kept PCID that would need more than this much of a write-protect range applied is dropped instead. */
+#define TLB_BANK_PEND_MAX (1 << 20)
+
+struct TLBBanks {
+    uint64_t clock;
+    TLBBank bank[TLB_NBANKS];
+};
