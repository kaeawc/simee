+
+static void tlb_bank_init(TLBBank *b)
+{
+    int64_t now = get_clock_realtime();
+
+    for (int i = 0; i < NB_MMU_MODES; i++) {
+        tlb_mmu_init(&b->d[i], &b->f[mmuidx_to_fast_index(i)], now);
+    }
+    b->dirty = 0;
+    b->init = true;
+    b->jc = g_new0(CPUJumpCache, 1);
+}
+
+/* Exchange the live tables with those of @b. Called with the lock held. */
+static void tlb_bank_swap_locked(CPUState *cpu, TLBBank *b)
+{
+    MMUIdxMap work = cpu->neg.tlb.c.dirty | b->dirty;
+    CPUJumpCache *jc;
+
+    /* A table that is clean on both sides is empty on both: nothing to move. */
+    for (; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc d = cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *lf = cpu_tlb_fast(cpu, mmu_idx);
+        CPUTLBDescFast *bf = &b->f[mmuidx_to_fast_index(mmu_idx)];
+        CPUTLBDescFast f = *lf;
+
+        cpu->neg.tlb.d[mmu_idx] = b->d[mmu_idx];
+        b->d[mmu_idx] = d;
+        *lf = *bf;
+        *bf = f;
+    }
+    work = cpu->neg.tlb.c.dirty;
+    cpu->neg.tlb.c.dirty = b->dirty;
+    b->dirty = work;
+
+    jc = cpu->tb_jmp_cache;
+    qatomic_set(&cpu->tb_jmp_cache, b->jc);
+    b->jc = jc;
+}
