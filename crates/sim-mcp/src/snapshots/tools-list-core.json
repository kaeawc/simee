        "readOnlyHint": false,
        "title": "shutdown"
      },
      "description": "Shut down. Destructive: deletes, stops or overwrites something; deleted or overwritten data is not recovered, and a stopped device or app can be started again. Can take a while (seconds to minutes): a client with the tasks extension gets a task to poll. Needs the user's confirmation for a device this client didn't boot: a client that supports elicitation asks the user; any other must pass `confirm: true`, which only a person's agreement allows.\n\nPlatforms: Android, iOS. Parameters: device. Toolsets: core, lifecycle.",
      "inputSchema": {
        "properties": {
          "confirm": {
            "description": "Only after the user has agreed, for a client that can't be asked itself: true confirms this call. A client that can be asked is asked, and this is ignored",
            "type": "boolean"
          },
          "device": {
            "description": "A device's UDID, name or `booted`",
            "type": "string"
          }
        },
        "required": [
          "device"
        ],
        "type": "object"
      },
      "name": "shutdown",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "title": "shutdown"
    },
